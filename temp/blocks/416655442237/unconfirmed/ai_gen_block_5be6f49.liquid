{% doc %}
  @prompt
    Create a new Liquid theme section called "contact" with the following specifications:
    
    **Section title:** CONTACT (displayed as a heading at the top)
    
    **Layout:** Clean, minimal, black and white style matching a modern fashion/retail brand aesthetic.
    
    **Contact info block** (displayed above or beside the form, in two columns):
    - EMAIL: 30LOVSTORE@GMAIL.COM
    - WHATSAPP: 786-651-8059
    - PHONE: 786-651-8059
    - HOURS: Monday to Friday, 9 AM – 6 PM
    - ADDRESS: Miami, FL
    
    **Contact form fields** (in a 2-column grid layout):
    - First Name (left) | Last Name (right)
    - Email Address (left) | Phone Number (right)
    - Message (full width textarea)
    - SEND button (full width, black background, white text, uppercase)
    
    **Design style:**
    - Black and white color scheme
    - Uppercase labels in small font
    - Clean input borders (thin, minimal)
    - Sans-serif typography
    - Section fully customizable via theme editor settings
    
    **Settings to expose in theme editor:**
    - Section heading
    - Email address
    - WhatsApp number
    - Phone number
    - Business hours
    - Business address
    - Button label
    - Background color
    - Text color
    
    The section should use Shopify's native contact form (form tag with type "contact") so form submissions go to the store's inbox.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-contact-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-contact-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-contact-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 40px;
  }

  @media screen and (min-width: 750px) {
    .ai-contact-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1.5fr;
      gap: 60px;
    }
  }

  .ai-contact-info-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-content: start;
  }

  @media screen and (min-width: 750px) {
    .ai-contact-info-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  .ai-contact-info-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-info-label-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-contact-info-value-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-contact-info-value-{{ ai_gen_id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-contact-info-value-{{ ai_gen_id }} a:hover {
    opacity: 0.7;
  }

  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-contact-form-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-contact-form-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form-field-{{ ai_gen_id }}.full-width {
    grid-column: 1 / -1;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ block.settings.text_color }};
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    font-family: inherit;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: 0;
    transition: border-color 0.2s ease;
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.text_color }};
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_background_color }};
    border: 1px solid {{ block.settings.button_background_color }};
    border-radius: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-contact-form-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-contact-success-{{ ai_gen_id }} {
    padding: 16px;
    margin-bottom: 20px;
    background-color: {{ block.settings.success_background }};
    color: {{ block.settings.success_text_color }};
    border: 1px solid {{ block.settings.success_text_color }};
    font-size: 14px;
  }

  .ai-contact-error-{{ ai_gen_id }} {
    padding: 16px;
    margin-bottom: 20px;
    background-color: {{ block.settings.error_background }};
    color: {{ block.settings.error_text_color }};
    border: 1px solid {{ block.settings.error_text_color }};
    font-size: 14px;
  }
{% endstyle %}

<contact-section-{{ ai_gen_id }} class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-contact-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    <div class="ai-contact-content-{{ ai_gen_id }}">
      <div class="ai-contact-info-{{ ai_gen_id }}">
        {% if block.settings.email != blank %}
          <div class="ai-contact-info-item-{{ ai_gen_id }}">
            <div class="ai-contact-info-label-{{ ai_gen_id }}">Email</div>
            <div class="ai-contact-info-value-{{ ai_gen_id }}">
              <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
            </div>
          </div>
        {% endif %}

        {% if block.settings.whatsapp != blank %}
          <div class="ai-contact-info-item-{{ ai_gen_id }}">
            <div class="ai-contact-info-label-{{ ai_gen_id }}">WhatsApp</div>
            <div class="ai-contact-info-value-{{ ai_gen_id }}">
              <a href="https://wa.me/{{ block.settings.whatsapp | replace: '-', '' | replace: ' ', '' }}">{{ block.settings.whatsapp }}</a>
            </div>
          </div>
        {% endif %}

        {% if block.settings.phone != blank %}
          <div class="ai-contact-info-item-{{ ai_gen_id }}">
            <div class="ai-contact-info-label-{{ ai_gen_id }}">Phone</div>
            <div class="ai-contact-info-value-{{ ai_gen_id }}">
              <a href="tel:{{ block.settings.phone | replace: '-', '' | replace: ' ', '' }}">{{ block.settings.phone }}</a>
            </div>
          </div>
        {% endif %}

        {% if block.settings.hours != blank %}
          <div class="ai-contact-info-item-{{ ai_gen_id }}">
            <div class="ai-contact-info-label-{{ ai_gen_id }}">Hours</div>
            <div class="ai-contact-info-value-{{ ai_gen_id }}">{{ block.settings.hours }}</div>
          </div>
        {% endif %}

        {% if block.settings.address != blank %}
          <div class="ai-contact-info-item-{{ ai_gen_id }}" style="grid-column: 1 / -1;">
            <div class="ai-contact-info-label-{{ ai_gen_id }}">Address</div>
            <div class="ai-contact-info-value-{{ ai_gen_id }}">{{ block.settings.address }}</div>
          </div>
        {% endif %}
      </div>

      <div class="ai-contact-form-wrapper-{{ ai_gen_id }}">
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="ai-contact-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="ai-contact-error-{{ ai_gen_id }}">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="ai-contact-form-grid-{{ ai_gen_id }}">
            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-first-name-{{ ai_gen_id }}">
                First Name
              </label>
              <input
                type="text"
                id="contact-first-name-{{ ai_gen_id }}"
                name="contact[first_name]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                autocomplete="given-name"
                required
              >
            </div>

            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-last-name-{{ ai_gen_id }}">
                Last Name
              </label>
              <input
                type="text"
                id="contact-last-name-{{ ai_gen_id }}"
                name="contact[last_name]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                autocomplete="family-name"
                required
              >
            </div>

            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-email-{{ ai_gen_id }}">
                Email Address
              </label>
              <input
                type="email"
                id="contact-email-{{ ai_gen_id }}"
                name="contact[email]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                autocomplete="email"
                required
              >
            </div>

            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-phone-{{ ai_gen_id }}">
                Phone Number
              </label>
              <input
                type="tel"
                id="contact-phone-{{ ai_gen_id }}"
                name="contact[phone]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                autocomplete="tel"
              >
            </div>

            <div class="ai-contact-form-field-{{ ai_gen_id }} full-width">
              <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-message-{{ ai_gen_id }}">
                Message
              </label>
              <textarea
                id="contact-message-{{ ai_gen_id }}"
                name="contact[body]"
                class="ai-contact-form-textarea-{{ ai_gen_id }}"
                required
              ></textarea>
            </div>

            <div class="ai-contact-form-field-{{ ai_gen_id }} full-width">
              <button type="submit" class="ai-contact-form-button-{{ ai_gen_id }}">
                {{ block.settings.button_label }}
              </button>
            </div>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</contact-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form) {
          form.addEventListener('submit', function() {
            const button = form.querySelector('.ai-contact-form-button-{{ ai_gen_id }}');
            if (button) {
              button.disabled = true;
              button.textContent = 'Sending...';
            }
          });
        }
      }
    }

    customElements.define('contact-section-{{ ai_gen_id }}', ContactSection{{ ai_gen_id }});
  })();
</script>

