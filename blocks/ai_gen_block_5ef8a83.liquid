{% doc %}
  @prompt
    Create a new Liquid theme section called "contact" with the following specifications:
    
    **Section title:** CONTACT (displayed as a large heading at the top, centered, uppercase)
    
    **Layout:** Clean, minimal, black and white style matching a modern fashion/retail brand aesthetic.
    
    **Contact info block** (displayed in two columns above the form). Show ONLY these items — DO NOT add a PHONE item here:
    - EMAIL: 30LOVSTORE@GMAIL.COM
    - WHATSAPP: 786-651-8059
    - HOURS: Monday to Friday, 9 AM – 6 PM
    - ADDRESS: Miami, FL
    
    **Contact form fields** (in a 2-column grid layout):
    - First Name (left) | Last Name (right)
    - Email Address (left) | Phone Number (right)
    - Message (full width textarea)
    - SEND button (full width, black background, white text, uppercase)
    
    **Success message:** When the form is submitted successfully, show a confirmation message with background color #9e4624 and white text.
    
    **Design style:**
    - Black and white color scheme
    - Contact info labels (EMAIL, WHATSAPP, HOURS, ADDRESS) must be bold (font-weight: bold)
    - Uppercase labels in small tracking-wide font
    - Clean thin input borders, no border-radius
    - Sans-serif typography
    - Horizontal divider lines between sections
    
    **Settings to expose in theme editor:**
    - Section heading
    - Email address
    - WhatsApp number
    - Business hours
    - Business address
    - Button label
    - Background color
    - Text color
    
    The section must use Shopify's native contact form (form tag with type "contact") so submissions go to the store inbox.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-contact-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-contact-heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: 48px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 60px;
    color: {{ block.settings.text_color }};
  }

  .ai-contact-divider-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background-color: {{ block.settings.text_color }};
    margin: 40px 0;
    opacity: 0.2;
  }

  .ai-contact-info-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-bottom: 40px;
  }

  .ai-contact-info-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-info-label-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: {{ block.settings.text_color }};
  }

  .ai-contact-info-value-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-contact-form-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form-field-{{ ai_gen_id }}.full-width {
    grid-column: 1 / -1;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: {{ block.settings.text_color }};
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 0;
    background-color: transparent;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-family: inherit;
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.text_color }};
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 150px;
    resize: vertical;
  }

  .ai-contact-form-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    background-color: {{ block.settings.text_color }};
    color: {{ block.settings.background_color }};
    border: none;
    border-radius: 0;
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-contact-form-button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-contact-success-{{ ai_gen_id }} {
    padding: 20px;
    background-color: {{ block.settings.success_bg_color }};
    color: #ffffff;
    text-align: center;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .ai-contact-error-{{ ai_gen_id }} {
    padding: 20px;
    background-color: #d82c0d;
    color: #ffffff;
    text-align: center;
    margin-bottom: 20px;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-heading-{{ ai_gen_id }} {
      font-size: 32px;
      margin-bottom: 40px;
    }

    .ai-contact-info-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-contact-form-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<contact-section-{{ ai_gen_id }} class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    <h1 class="ai-contact-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>

    <div class="ai-contact-info-grid-{{ ai_gen_id }}">
      <div class="ai-contact-info-item-{{ ai_gen_id }}">
        <div class="ai-contact-info-label-{{ ai_gen_id }}">EMAIL</div>
        <div class="ai-contact-info-value-{{ ai_gen_id }}"><a href="mailto:30lovstore@gmail.com" style="color: inherit; text-decoration: none;">30lovstore@gmail.com</a></div>

      </div>

      <div class="ai-contact-info-item-{{ ai_gen_id }}">
        <div class="ai-contact-info-label-{{ ai_gen_id }}">WHATSAPP</div>
        <div class="ai-contact-info-value-{{ ai_gen_id }}"><a href="https://wa.me/17866518059" style="color: inherit; text-decoration: none;">+1 (786) 651-8059</a></div>

      </div>

      <div class="ai-contact-info-item-{{ ai_gen_id }}">
        <div class="ai-contact-info-label-{{ ai_gen_id }}">HOURS</div>
        <div class="ai-contact-info-value-{{ ai_gen_id }}">{{ block.settings.hours }}</div>
      </div>

      <div class="ai-contact-info-item-{{ ai_gen_id }}">
        <div class="ai-contact-info-label-{{ ai_gen_id }}">ADDRESS</div>
        <div class="ai-contact-info-value-{{ ai_gen_id }}">{{ block.settings.address }}</div>
      </div>
    </div>

    <div class="ai-contact-divider-{{ ai_gen_id }}"></div>

    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <div class="ai-contact-success-{{ ai_gen_id }}" id="ai-contact-success-{{ ai_gen_id }}">
          Thank you for contacting us. We'll get back to you as soon as possible.
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="ai-contact-error-{{ ai_gen_id }}" id="ai-contact-error-{{ ai_gen_id }}">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="ai-contact-form-grid-{{ ai_gen_id }}">
        <div class="ai-contact-form-field-{{ ai_gen_id }}">
          <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-first-name-{{ ai_gen_id }}">
            First Name
          </label>
          <input
            type="text"
            id="contact-first-name-{{ ai_gen_id }}"
            name="contact[first_name]"
            class="ai-contact-form-input-{{ ai_gen_id }}"
            required
            {% if form.errors %}
              aria-describedby="ai-contact-error-{{ ai_gen_id }}"
            {% endif %}
          >
        </div>

        <div class="ai-contact-form-field-{{ ai_gen_id }}">
          <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-last-name-{{ ai_gen_id }}">
            Last Name
          </label>
          <input
            type="text"
            id="contact-last-name-{{ ai_gen_id }}"
            name="contact[last_name]"
            class="ai-contact-form-input-{{ ai_gen_id }}"
            required
            {% if form.errors %}
              aria-describedby="ai-contact-error-{{ ai_gen_id }}"
            {% endif %}
          >
        </div>

        <div class="ai-contact-form-field-{{ ai_gen_id }}">
          <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-email-{{ ai_gen_id }}">
            Email Address
          </label>
          <input
            type="email"
            id="contact-email-{{ ai_gen_id }}"
            name="contact[email]"
            class="ai-contact-form-input-{{ ai_gen_id }}"
            autocomplete="email"
            required
            {% if form.errors %}
              aria-describedby="ai-contact-error-{{ ai_gen_id }}"
            {% endif %}
          >
        </div>

        <div class="ai-contact-form-field-{{ ai_gen_id }}">
          <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-phone-{{ ai_gen_id }}">
            Phone Number
          </label>
          <input
            type="tel"
            id="contact-phone-{{ ai_gen_id }}"
            name="contact[phone]"
            class="ai-contact-form-input-{{ ai_gen_id }}"
            autocomplete="tel"
            {% if form.errors %}
              aria-describedby="ai-contact-error-{{ ai_gen_id }}"
            {% endif %}
          >
        </div>

        <div class="ai-contact-form-field-{{ ai_gen_id }} full-width">
          <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-message-{{ ai_gen_id }}">
            Message
          </label>
          <textarea
            id="contact-message-{{ ai_gen_id }}"
            name="contact[body]"
            class="ai-contact-form-textarea-{{ ai_gen_id }}"
            required
            {% if form.errors %}
              aria-describedby="ai-contact-error-{{ ai_gen_id }}"
            {% endif %}
          ></textarea>
        </div>

        <div class="ai-contact-form-field-{{ ai_gen_id }} full-width">
          <button type="submit" class="ai-contact-form-button-{{ ai_gen_id }}">
            {{ block.settings.button_label }}
          </button>
        </div>
      </div>
    {% endform %}
  </div>
</contact-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const successMessage = this.querySelector('#ai-contact-success-{{ ai_gen_id }}');
        if (successMessage) {
          successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }

    customElements.define('contact-section-{{ ai_gen_id }}', ContactSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CONTACT"
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "30LOVSTORE@GMAIL.COM"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp number",
      "default": "786-651-8059"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "default": "Monday to Friday, 9 AM – 6 PM"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Business address",
      "default": "Miami, FL"
    },
    {
      "type": "header",
      "content": "Form settings"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SEND"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "success_bg_color",
      "label": "Success message background",
      "default": "#9e4624"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
